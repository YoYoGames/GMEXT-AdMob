[gml_api]
module GMAdMob;

// -----------------------------------------------------------------------------
// Shared callback types
// -----------------------------------------------------------------------------

// Uniform success/failure envelope for every async callback in this extension.
// error_message and sdk_error_code are both absent on success. sdk_error_code
// carries Google's own LoadAdError/AdError code verbatim when the failure came
// from the SDK; absent when the extension rejected the call before ever
// reaching Google (see the AdMobError sync return codes below).
[global]
class `[[AdMobResult]]` prototype Object
{
    [field] property success : bool { get; set; }
    [field, type_hint=`string?`] property error_message : gmval { get; set; }
    [field, type_hint=`int32?`] property sdk_error_code : gmval { get; set; }
}

// Mirrors RewardItem.getAmount()/getType() directly.
[global]
class `[[AdMobReward]]` prototype Object
{
    [field] property amount : real { get; set; }
    [field] property type : string { get; set; }
}

// Delivered by AdMob's OnPaidEventListener - always a success signal (Google's SDK has no
// failure case for this event), so unlike AdMobResult there is no success/error_message pair.
// ad_type/ad_unit_id are enrichment this extension adds (a single paid-event callback is shared
// across every ad family); the rest mirrors AdValue/AdapterResponseInfo directly.
[global]
class `[[AdMobPaidEvent]]` prototype Object
{
    [field, type_hint=`AdMobAdType`] property ad_type : gmval { get; set; }
    [field] property ad_unit_id : string { get; set; }
    [field] property value_micros : real { get; set; }
    [field] property currency_code : string { get; set; }
    [field, type_hint=`AdMobPrecisionType`] property precision : gmval { get; set; }
    [field] property mediation_adapter_class_name : string { get; set; }
    [field, type_hint=`string?`] property ad_source_name : gmval { get; set; }
    [field, type_hint=`string?`] property ad_source_id : gmval { get; set; }
    [field, type_hint=`string?`] property ad_source_instance_name : gmval { get; set; }
    [field, type_hint=`string?`] property ad_source_instance_id : gmval { get; set; }
}

// -----------------------------------------------------------------------------
// Initialization / setup
// -----------------------------------------------------------------------------

/// callback(result: AdMobResult) once initialization completes or fails.
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_initialize(callback: func): gmval;

[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_set_test_device_id(): gmval;

/// callback(event: AdMobPaidEvent) once per paid ad impression, across every ad family.
[global, bind = typed_gml]
function admob_events_on_paid_event(enabled: bool, callback: func): unit;

// -----------------------------------------------------------------------------
// Banner
// -----------------------------------------------------------------------------

[global, bind = typed_gml]
function admob_banner_set_ad_unit(ad_unit_id: string): unit;

/// callback(result: AdMobResult, type: AdMobBannerCallbackEvent) - fires once per lifecycle
/// event (Loaded/LoadFailed/Opened/Clicked/Impression/Closed) for as long as the banner exists.
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_banner_create(
    [type_hint=`AdMobBannerSize`] size,
    bottom: bool,
    callback: func
): gmval;

/// callback(result: AdMobResult, type: AdMobBannerCallbackEvent) - see admob_banner_create.
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_banner_create_ext(
    [type_hint=`AdMobBannerSize`] size,
    bottom: bool,
    [type_hint=`AdMobBannerAlignment`] alignment,
    callback: func
): gmval;

[global, bind = typed_gml]
function admob_banner_get_width(): real;

[global, bind = typed_gml]
function admob_banner_get_height(): real;

[global, bind = typed_gml]
function admob_banner_move(bottom: bool): unit;

[global, bind = typed_gml]
function admob_banner_show(): unit;

[global, bind = typed_gml]
function admob_banner_hide(): unit;

[global, bind = typed_gml]
function admob_banner_remove(): unit;

// -----------------------------------------------------------------------------
// Interstitial
// -----------------------------------------------------------------------------

[global, bind = typed_gml]
function admob_interstitial_set_ad_unit(ad_unit_id: string): unit;

/// callback(result: AdMobResult, handle: uint64?) - handle present only on success.
/// ad_unit_id is optional; omit to use the unit set by admob_interstitial_set_ad_unit.
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_interstitial_load(
    callback: func,
    [type_hint=`string?`] ad_unit_id: gmval
): gmval;

[global, bind = typed_gml]
function admob_interstitial_is_valid([type_hint=`uint64`] handle: gmval): bool;

[global, bind = typed_gml]
function admob_interstitial_dispose([type_hint=`uint64`] handle: gmval): unit;

/// callback(result: AdMobResult, type: AdMobInterstitialShowEvent) on success;
/// callback(result: AdMobResult) with success = false on failure or an invalid/consumed handle.
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_interstitial_show(
    [type_hint=`uint64`] handle: gmval,
    callback: func
): gmval;

// -----------------------------------------------------------------------------
// Server-side verification
// -----------------------------------------------------------------------------

[global, bind = typed_gml]
function admob_server_side_verification_set(
    user_id: string,
    custom_data: string
): unit;

[global, bind = typed_gml]
function admob_server_side_verification_clear(): unit;

// -----------------------------------------------------------------------------
// Rewarded video
// -----------------------------------------------------------------------------

[global, bind = typed_gml]
function admob_rewarded_video_set_ad_unit(ad_unit_id: string): unit;

/// callback(result: AdMobResult, handle: uint64?) - handle present only on success.
/// ad_unit_id is optional; omit to use the unit set by admob_rewarded_video_set_ad_unit.
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_rewarded_video_load(
    callback: func,
    [type_hint=`string?`] ad_unit_id: gmval
): gmval;

[global, bind = typed_gml]
function admob_rewarded_video_is_valid([type_hint=`uint64`] handle: gmval): bool;

[global, bind = typed_gml]
function admob_rewarded_video_dispose([type_hint=`uint64`] handle: gmval): unit;

/// callback(result: AdMobResult, type: AdMobRewardedVideoShowEvent, reward: AdMobReward?) on
/// success - reward is present only when type = Reward.
/// callback(result: AdMobResult) with success = false on failure or an invalid/consumed handle.
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_rewarded_video_show(
    [type_hint=`uint64`] handle: gmval,
    callback: func
): gmval;

// -----------------------------------------------------------------------------
// Rewarded interstitial
// -----------------------------------------------------------------------------

[global, bind = typed_gml]
function admob_rewarded_interstitial_set_ad_unit(ad_unit_id: string): unit;

/// callback(result: AdMobResult, handle: uint64?) - handle present only on success.
/// ad_unit_id is optional; omit to use the unit set by admob_rewarded_interstitial_set_ad_unit.
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_rewarded_interstitial_load(
    callback: func,
    [type_hint=`string?`] ad_unit_id: gmval
): gmval;

[global, bind = typed_gml]
function admob_rewarded_interstitial_is_valid([type_hint=`uint64`] handle: gmval): bool;

[global, bind = typed_gml]
function admob_rewarded_interstitial_dispose([type_hint=`uint64`] handle: gmval): unit;

/// callback(result: AdMobResult, type: AdMobRewardedInterstitialShowEvent, reward: AdMobReward?)
/// on success - reward is present only when type = Reward.
/// callback(result: AdMobResult) with success = false on failure or an invalid/consumed handle.
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_rewarded_interstitial_show(
    [type_hint=`uint64`] handle: gmval,
    callback: func
): gmval;

// -----------------------------------------------------------------------------
// App-open ads
// -----------------------------------------------------------------------------

[global, bind = typed_gml]
function admob_app_open_ad_set_ad_unit(ad_unit_id: string): unit;

/// callback(result: AdMobResult) on load outcome, then callback(result, type: AdMobAppOpenAdShowEvent)
/// per show-lifecycle event whenever this ad auto-shows - same callback as admob_app_open_ad_load/
/// _show unless one of those supplies its own.
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_app_open_ad_enable(
    callback: func
): gmval;

[global, bind = typed_gml]
function admob_app_open_ad_disable(): unit;

[global, bind = typed_gml]
function admob_app_open_ad_is_enabled(): bool;

[global, bind = typed_gml]
function admob_app_open_ad_is_loaded(): bool;

/// callback(result: AdMobResult) on load outcome.
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_app_open_ad_load(callback: func): gmval;

/// callback(result: AdMobResult, type: AdMobAppOpenAdShowEvent) on success;
/// callback(result) with success = false on show failure.
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_app_open_ad_show(callback: func): gmval;

// -----------------------------------------------------------------------------
// Targeting
// -----------------------------------------------------------------------------

[global, bind = typed_gml]
function admob_targeting_coppa(coppa: bool): unit;

[global, bind = typed_gml]
function admob_targeting_under_age(under_age: bool): unit;

[global, bind = typed_gml]
function admob_targeting_max_ad_content_rating(
    [type_hint=`AdMobMaxAdContentRating`] content_rating
): unit;

// -----------------------------------------------------------------------------
// Consent
// -----------------------------------------------------------------------------

/// callback(result: AdMobResult).
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_consent_request_info_update(
    [type_hint=`AdMobConsentDebugGeography`] debug_geography,
    callback: func
): gmval;

[global, bind = typed_gml, type_hint=`AdMobConsentStatus`]
function admob_consent_get_status(): gmval;

[global, bind = typed_gml, type_hint=`AdMobConsentType`]
function admob_consent_get_type(): gmval;

[global, bind = typed_gml]
function admob_consent_is_form_available(): bool;

/// callback(result: AdMobResult).
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_consent_load(callback: func): gmval;

/// callback(result: AdMobResult) - fires once the consent form is dismissed.
[global, bind = typed_gml, type_hint=`AdMobError`]
function admob_consent_show(callback: func): gmval;

[global, bind = typed_gml]
function admob_consent_reset(): unit;

[global, bind = typed_gml]
function admob_consent_set_rdp(enabled: bool): unit;

// -----------------------------------------------------------------------------
// Settings
// -----------------------------------------------------------------------------

[global, bind = typed_gml]
function admob_settings_set_volume(value: real): unit;

[global, bind = typed_gml]
function admob_settings_set_muted(muted: bool): unit;

// -----------------------------------------------------------------------------
// Error/status enums
// -----------------------------------------------------------------------------

// Extension-defined error codes. These are not raw Google Mobile Ads SDK error codes.
[global, bind = typed_gml]
enum AdMobError:int32
{
    Ok = 0,
    NotInitialized = -1,
    InvalidAdId = -2,
    AdLimitReached = -3,
    NoAdsLoaded = -4,
    NoActiveBannerAd = -5,
    IllegalCall = -6,
    NullViewHandler = -7,
    InvalidHandle = -8,
}

// Extension-defined banner placement values.
[global, bind = typed_gml]
enum AdMobBannerAlignment:int32
{
    Left = 0,
    Center = 1,
    Right = 2,
}

// Extension-defined numeric mapping to Google banner-size APIs.
// SmartBanner is retained for compatibility but is deprecated by Google.
// AnchoredAdaptive should map to the current large anchored adaptive API.
[global, bind = typed_gml]
enum AdMobBannerSize:int32
{
    Banner = 0,
    LargeBanner = 1,
    MediumRectangle = 2,
    FullBanner = 3,
    Leaderboard = 4,
    SmartBanner = 5,
    AnchoredAdaptive = 6,
}

// Extension-defined numeric mapping. Native code must translate these values
// to Google's G, PG, T, and MA content-rating constants.
[global, bind = typed_gml]
enum AdMobMaxAdContentRating:int32
{
    General = 0,
    ParentalGuidance = 1,
    Teen = 2,
    MatureAudience = 3,
}

// Values match Android ConsentDebugSettings.DebugGeography and iOS
// UMPDebugGeography. NotEEA is deprecated by Google; use Other instead.
[global, bind = typed_gml]
enum AdMobConsentDebugGeography:int32
{
    Disabled = 0,
    EEA = 1,
    NotEEA = 2,
    RegulatedUSState = 3,
    Other = 4,
}

// Public cross-platform values follow Android UMP ConsentStatus.
// iOS uses Required = 1 and NotRequired = 2 internally, so the iOS native
// implementation must translate its raw UMPConsentStatus before returning it.
[global, bind = typed_gml]
enum AdMobConsentStatus:int32
{
    Unknown = 0,
    NotRequired = 1,
    Required = 2,
    Obtained = 3,
}

// Legacy extension-defined classification. Current Google UMP does not expose
// personalized, non-personalized, or declined as a ConsentInformation enum.
// Do not derive these values from AdMobConsentStatus.
[global, bind = typed_gml]
enum AdMobConsentType:int32
{
    Unknown = 0,
    NonPersonalized = 1,
    Personalized = 2,
    Declined = 3,
}

// Extension-owned - distinguishes which ad family a shared admob_events_on_paid_event
// callback fired for. Not a Google SDK enum (AdValue itself carries no ad-family concept).
[global, bind = typed_gml]
enum AdMobAdType:int32
{
    Banner = 0,
    Interstitial = 1,
    RewardedVideo = 2,
    RewardedInterstitial = 3,
    AppOpen = 4,
}

// Mirrors Android AdValue.PrecisionType / iOS GADAdValuePrecision - both use these
// same ordinals already, no per-platform translation needed.
[global, bind = typed_gml]
enum AdMobPrecisionType:int32
{
    Unknown = 0,
    Estimated = 1,
    PublisherProvided = 2,
    Precise = 3,
}

// -----------------------------------------------------------------------------
// Callback event enums
// -----------------------------------------------------------------------------
// Numeric values are extension-owned. Event names correspond to the relevant
// Google SDK callbacks; they are not raw SDK enum values.

// Banner has one ongoing callback for its whole lifecycle (unlike interstitial/rewarded's
// separate load-then-show pair), so Loaded/LoadFailed stay in this enum rather than folding
// into a separate load callback's AdMobResult.success.
[global, bind = typed_gml]
enum AdMobBannerCallbackEvent:int32
{
    Loaded = 0,
    LoadFailed = 1,
    Opened = 2,
    Clicked = 3,
    Closed = 4,
    Impression = 5,
}

// Loaded/LoadFailed/ShowFailed removed - covered by AdMobResult.success now.
// Clicked/Impression added (were dropped entirely by the old implementation).
[global, bind = typed_gml]
enum AdMobInterstitialShowEvent:int32
{
    Shown = 0,
    Dismissed = 1,
    Clicked = 2,
    Impression = 3,
}

// Loaded/LoadFailed/ShowFailed removed - covered by AdMobResult.success now.
// Clicked/Impression added (were dropped entirely by the old implementation).
[global, bind = typed_gml]
enum AdMobRewardedVideoShowEvent:int32
{
    Shown = 0,
    Dismissed = 1,
    Clicked = 2,
    Impression = 3,
    Reward = 4,
}

// Loaded/LoadFailed/ShowFailed removed - covered by AdMobResult.success now.
// Clicked/Impression added (were dropped entirely by the old implementation).
[global, bind = typed_gml]
enum AdMobRewardedInterstitialShowEvent:int32
{
    Shown = 0,
    Dismissed = 1,
    Clicked = 2,
    Impression = 3,
    Reward = 4,
}

// Loaded/LoadFailed/ShowFailed removed - covered by AdMobResult.success now.
// Clicked/Impression added (were dropped entirely by the old implementation).
[global, bind = typed_gml]
enum AdMobAppOpenAdShowEvent:int32
{
    Shown = 0,
    Dismissed = 1,
    Clicked = 2,
    Impression = 3,
}
